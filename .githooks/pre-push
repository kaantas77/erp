#!/bin/sh
# Push oncesi yerel kontrol: mise/venv gerektirmeden calisir.
# Kurulum:  git config core.hooksPath .githooks
# Kaldirma: git config --unset core.hooksPath

set -e

PY=".venv/bin/python"
RUFF=".venv/bin/ruff"

if [ ! -x "$PY" ]; then
  echo "hata: .venv bulunamadi. Once 'make install' calistir." >&2
  exit 1
fi

echo "== ruff check =="
"$RUFF" check .

echo "== ruff format --check =="
"$RUFF" format --check .

echo "== migration tutarliligi =="
"$PY" manage.py makemigrations --check --dry-run

echo "== testler =="
"$PY" -m pytest -q

echo "Tum kontroller gecti."
